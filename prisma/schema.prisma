  orderBooked    Decimal?       @map("order_booked") @db.Decimal(14, 2)
  collectionMade Decimal?       @map("collection_made") @db.Decimal(14, 2)
  followUpDate   DateTime?      @map("follow_up_date")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner        BatteryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId])
  @@index([tenantId, salesUserId, visitDate])
  @@map("battery_field_visits")
}

model MarketingFestival {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  date      String
  title     String
  tag       String
  desc      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("marketing_festivals")
}



